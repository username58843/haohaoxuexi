# MongoDB connection string (MongoDB Atlas or local instance).
# The database name must be part of the URI path.
# Local: mongodb://127.0.0.1:27017/haohaoxuexi
MONGODB_URI=mongodb://127.0.0.1:27017/haohaoxuexi

# Secret for signing JWTs. Generate a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Public origin of the deployed web app.
APP_URL=http://localhost:3000
