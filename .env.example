# MongoDB connection string (MongoDB Atlas or local instance).
# The database name must be part of the URI path.
# Local: mongodb://127.0.0.1:27017/haohaoxuexi
MONGODB_URI=mongodb://127.0.0.1:27017/haohaoxuexi

# Secret for signing JWTs. Generate a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Public origin of the deployed web app.
APP_URL=http://localhost:3000

# Cloudflare Turnstile (captcha). Leave empty to disable the captcha checks.
# Get keys at https://dash.cloudflare.com/turnstile
TURNSTILE_SECRET=

# Resend (transactional email: verification codes, password-reset links).
# Required for the email-verification flow — sign-ups cannot complete
# verification without it. Get a key at https://resend.com
RESEND_API_KEY=
# Optional sender override, e.g. "haohaoxuexi <noreply@your-domain>".
RESEND_FROM=

# ---- Books: AI retelling (optional) ----
# One key is enough; the first configured provider wins (Groq → Gemini →
# OpenRouter). All three have free tiers. Leave empty to hide the AI panel.
# https://console.groq.com  |  https://aistudio.google.com  |  https://openrouter.ai
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Optional model overrides:
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.0-flash
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
