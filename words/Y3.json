[{"simplified":"讲究","traditional":"講究","pinyin":"jiǎngjiu","definitions":["придавать значение","быть требовательным","заботиться о качестве","изысканный","привередливый"],"example":{"zh":"他吃饭很讲究。","py":"Tā chī fàn hěn jiǎngjiu.","en":"He is very particular about food.","ru":"Он очень разборчив в еде."}},{"simplified":"世纪","traditional":"世紀","pinyin":"shìjì","definitions":["век","столетие"],"example":{"zh":"现在是二十一世纪。","py":"xiànzài shì èrshíyī shìjì。","en":"It is now the twenty-first century.","ru":"Сейчас двадцать первый век."}},{"simplified":"周末","traditional":"週末","pinyin":"zhōumò","definitions":["выходные","конец недели"],"example":{"zh":"周末我在家休息。","py":"zhōumò wǒ zài jiā xiūxi。","en":"On the weekend I rest at home.","ru":"На выходных я отдыхаю дома."},"translations":{"tk":["dynç günleri"]}},{"simplified":"女婿","traditional":"女婿","pinyin":"nǚxu","definitions":["зять (муж дочери)"],"example":{"zh":"女婿帮老人修好了房子。","py":"nǚxu bāng lǎorén xiū hǎo le fángzi。","en":"The son-in-law helped the old couple fix the house.","ru":"Зять помог старикам починить дом."}},{"simplified":"眼看","traditional":"眼看","pinyin":"yǎnkàn","definitions":["видеть своими глазами","на глазах","вот-вот","скоро уже"],"example":{"zh":"眼看要下雨了，快走吧。","py":"yǎnkàn yào xiàyǔ le，kuài zǒu ba。","en":"It's about to rain — let's hurry.","ru":"Вот-вот пойдёт дождь, поспешим."}},{"simplified":"老家","traditional":"老家","pinyin":"lǎojiā","definitions":["родной дом","родина","родные места"],"example":{"zh":"过年他要回老家。","py":"guònián tā yào huí lǎojiā。","en":"He goes back to his hometown for New Year.","ru":"На Новый год он едет в родные края."}},{"simplified":"儿媳","traditional":"兒媳","pinyin":"érxí","definitions":["невестка","жена сына","сноха"],"example":{"zh":"儿媳对老人很孝顺。","py":"érxí duì lǎorén hěn xiàoshùn。","en":"The daughter-in-law is very dutiful to the elders.","ru":"Невестка очень заботится о стариках."}}]