[{"simplified":"封","traditional":"封","pinyin":"fēng","definitions":["запечатывать","конверт","мера для писем"],"example":{"zh":"我收到了一封信。","py":"wǒ shōudào le yī fēng xìn。","en":"I received a letter.","ru":"Я получил письмо."}},{"simplified":"上","traditional":"上","pinyin":"shàng","definitions":["вверх","на","подниматься"],"example":{"zh":"书在桌子上。","py":"shū zài zhuōzi shang。","en":"The book is on the table.","ru":"Книга на столе."},"translations":{"tk":["ýokarda","üstünde"]}},{"simplified":"基本上","traditional":"基本上","pinyin":"jīběn shàng","definitions":["в основном","по сути"],"example":{"zh":"作业基本上写完了。","py":"zuòyè jīběnshàng xiě wán le。","en":"The homework is basically finished.","ru":"Домашнее задание в основном сделано."}},{"simplified":"基本","traditional":"基本","pinyin":"jīběn","definitions":["основной","базовый"],"example":{"zh":"这些是基本的知识。","py":"Zhèxiē shì jīběn de zhīshi.","en":"These are basic facts to know.","ru":"Это базовые знания."}},{"simplified":"交","traditional":"交","pinyin":"jiāo","definitions":["передавать","обмениваться","дружить"],"example":{"zh":"请明天交作业。","py":"qǐng míngtiān jiāo zuòyè。","en":"Please hand in the homework tomorrow.","ru":"Пожалуйста, сдайте домашнее задание завтра."}},{"simplified":"分别","traditional":"分別","pinyin":"fēnbié","definitions":["расставаться","отдельно","различать"],"example":{"zh":"我们在车站分别了。","py":"wǒmen zài chēzhàn fēnbié le。","en":"We parted at the station.","ru":"Мы расстались на вокзале."}},{"simplified":"来自","traditional":"來自","pinyin":"láizì","definitions":["происходить из","быть родом из"],"example":{"zh":"他来自一个小城市。","py":"Tā láizì yí ge xiǎo chéngshì.","en":"He comes from a small city.","ru":"Он родом из небольшого города."}},{"simplified":"自","traditional":"自","pinyin":"zì","definitions":["из","с","сам"],"example":{"zh":"他自小在北京长大。","py":"tā zì xiǎo zài Běijīng zhǎngdà。","en":"He grew up in Beijing from childhood.","ru":"Он с детства рос в Пекине."}},{"simplified":"等","traditional":"等","pinyin":"děng","definitions":["ждать","класс","уровень"],"example":{"zh":"请在门口等我。","py":"qǐng zài ménkǒu děng wǒ。","en":"Please wait for me at the door.","ru":"Пожалуйста, подожди меня у входа."}},{"simplified":"洲","traditional":"洲","pinyin":"zhōu","definitions":["континент","материк"],"example":{"zh":"世界上有七大洲。","py":"shìjiè shang yǒu qī dà zhōu。","en":"There are seven continents in the world.","ru":"В мире семь континентов."}},{"simplified":"课外","traditional":"課外","pinyin":"kèwài","definitions":["внеклассный","внеурочный"],"example":{"zh":"他参加了很多课外活动。","py":"tā cānjiā le hěn duō kèwài huódòng。","en":"He takes part in many extracurricular activities.","ru":"Он участвует во многих внеклассных занятиях."}},{"simplified":"关心","traditional":"關心","pinyin":"guānxīn","definitions":["заботиться","интересоваться"],"example":{"zh":"谢谢你关心我。","py":"xièxie nǐ guānxīn wǒ。","en":"Thank you for caring about me.","ru":"Спасибо, что заботишься обо мне."},"translations":{"tk":["alada etmek","üns bermek"]}},{"simplified":"团结","traditional":"團結","pinyin":"tuánjié","definitions":["сплочённость","объединяться"],"example":{"zh":"我们班很团结。","py":"Wǒmen bān hěn tuánjié.","en":"Our class is very united.","ru":"Наш класс очень сплочённый."}},{"simplified":"站","traditional":"站","pinyin":"zhàn","definitions":["стоять","станция","остановка"],"example":{"zh":"我在公共汽车站等你。","py":"wǒ zài gōnggòng qìchē zhàn děng nǐ。","en":"I'll wait for you at the bus stop.","ru":"Я жду тебя на автобусной остановке."},"translations":{"tk":["durmak","duralga"]}},{"simplified":"个子","traditional":"個子","pinyin":"gèzi","definitions":["рост","телосложение"],"example":{"zh":"他的个子很高。","py":"tā de gèzi hěn gāo。","en":"He is very tall.","ru":"Он высокого роста."}},{"simplified":"黄","traditional":"黃","pinyin":"huáng","definitions":["жёлтый"],"example":{"zh":"香蕉是黄色的。","py":"xiāngjiāo shì huángsè de。","en":"Bananas are yellow.","ru":"Бананы жёлтые."},"translations":{"tk":["sary"]}},{"simplified":"拍","traditional":"拍","pinyin":"pāi","definitions":["хлопать","снимать (фото/видео)"],"example":{"zh":"他轻轻拍了我一下。","py":"Tā qīngqīng pāi le wǒ yíxià.","en":"He gave me a light pat.","ru":"Он легонько похлопал меня."}},{"simplified":"柔和","traditional":"柔和","pinyin":"róuhé","definitions":["мягкий","нежный"],"example":{"zh":"这里的灯光很柔和。","py":"Zhèlǐ de dēngguāng hěn róuhé.","en":"The lighting here is very soft.","ru":"Здесь очень мягкий свет."}},{"simplified":"缓慢","traditional":"緩慢","pinyin":"huǎnmàn","definitions":["медленный","постепенный"],"example":{"zh":"老人缓慢地过马路。","py":"lǎorén huǎnmàn de guò mǎlù。","en":"The old man crossed the road slowly.","ru":"Старик медленно переходил дорогу."}},{"simplified":"优美","traditional":"優美","pinyin":"yōuměi","definitions":["изящный","грациозный"],"example":{"zh":"这里的风景很优美。","py":"zhèlǐ de fēngjǐng hěn yōuměi。","en":"The scenery here is beautiful.","ru":"Здесь очень красивые виды."}},{"simplified":"舒展","traditional":"舒展","pinyin":"shūzhǎn","definitions":["расправляться","растягиваться"],"example":{"zh":"做操可以舒展身体。","py":"zuò cāo kěyǐ shūzhǎn shēntǐ。","en":"Doing exercises stretches the body.","ru":"Зарядка помогает размять тело."}},{"simplified":"增强","traditional":"增強","pinyin":"zēngqiáng","definitions":["усиливать","укреплять"],"example":{"zh":"锻炼能增强体质。","py":"duànliàn néng zēngqiáng tǐzhì。","en":"Exercise strengthens the constitution.","ru":"Тренировки укрепляют организм."}},{"simplified":"体质","traditional":"體質","pinyin":"tǐzhì","definitions":["телосложение","физическое состояние"],"example":{"zh":"他的体质越来越好。","py":"tā de tǐzhì yuèláiyuè hǎo。","en":"His constitution is getting better and better.","ru":"Его здоровье становится всё крепче."}},{"simplified":"预防","traditional":"預防","pinyin":"yùfáng","definitions":["предотвращать","профилактика"],"example":{"zh":"多喝水可以预防感冒。","py":"duō hē shuǐ kěyǐ yùfáng gǎnmào。","en":"Drinking more water can prevent colds.","ru":"Пить больше воды помогает предотвратить простуду."}},{"simplified":"疾病","traditional":"疾病","pinyin":"jíbìng","definitions":["болезнь","заболевание"],"example":{"zh":"这种疾病很难治。","py":"Zhè zhǒng jíbìng hěn nán zhì.","en":"This disease is hard to cure.","ru":"Эту болезнь трудно вылечить."}},{"simplified":"作用","traditional":"作用","pinyin":"zuòyòng","definitions":["роль","воздействие","функция"],"example":{"zh":"这个药的作用很大。","py":"zhège yào de zuòyòng hěn dà。","en":"This medicine has a strong effect.","ru":"Это лекарство очень действенное."},"translations":{"tk":["täsir","orun"]}},{"simplified":"项","traditional":"項","pinyin":"xiàng","definitions":["пункт","элемент","мера для дел"],"example":{"zh":"这项工作很重要。","py":"zhè xiàng gōngzuò hěn zhòngyào。","en":"This piece of work is very important.","ru":"Эта работа очень важная."}},{"simplified":"后","traditional":"後","pinyin":"hòu","definitions":["после","позади","задний"],"example":{"zh":"下课后我们去打球。","py":"xiàkè hòu wǒmen qù dǎqiú。","en":"After class we go play ball.","ru":"После уроков мы идём играть в мяч."}},{"simplified":"书画","traditional":"書畫","pinyin":"shūhuà","definitions":["каллиграфия и живопись"],"example":{"zh":"爷爷喜欢收藏书画。","py":"yéye xǐhuan shōucáng shūhuà。","en":"Grandpa likes collecting calligraphy and paintings.","ru":"Дедушка любит коллекционировать каллиграфию и живопись."}},{"simplified":"竹子","traditional":"竹子","pinyin":"zhúzi","definitions":["бамбук"],"example":{"zh":"熊猫最爱吃竹子。","py":"xióngmāo zuì ài chī zhúzi。","en":"Pandas love eating bamboo most of all.","ru":"Панды больше всего любят есть бамбук."}},{"simplified":"诗","traditional":"詩","pinyin":"shī","definitions":["стихотворение","поэзия"],"example":{"zh":"他给她写了一首诗。","py":"tā gěi tā xiě le yì shǒu shī。","en":"He wrote her a poem.","ru":"Он написал ей стихотворение."}},{"simplified":"橱窗","traditional":"櫥窗","pinyin":"chúchuāng","definitions":["витрина"],"example":{"zh":"橱窗里摆着新款手表。","py":"chúchuāng li bǎi zhe xīnkuǎn shǒubiǎo。","en":"New watches are displayed in the shop window.","ru":"В витрине выставлены новые часы."}},{"simplified":"展出","traditional":"展出","pinyin":"zhǎnchū","definitions":["выставлять","демонстрировать"],"example":{"zh":"博物馆展出了古代文物。","py":"bówùguǎn zhǎnchū le gǔdài wénwù。","en":"The museum exhibited ancient artifacts.","ru":"Музей выставил древние реликвии."}},{"simplified":"表示","traditional":"表示","pinyin":"biǎoshì","definitions":["выражать","обозначать"],"example":{"zh":"他表示同意了。","py":"tā biǎoshì tóngyì le。","en":"He expressed his agreement.","ru":"Он выразил согласие."},"translations":{"tk":["bildirmek","aňlatmak"]}},{"simplified":"筷子","traditional":"筷子","pinyin":"kuàizi","definitions":["палочки для еды"],"example":{"zh":"我会用筷子吃饭。","py":"wǒ huì yòng kuàizi chī fàn。","en":"I can eat with chopsticks.","ru":"Я умею есть палочками."},"translations":{"tk":["taýajyklar (nahar üçin)"]}},{"simplified":"好玩儿","traditional":"好玩兒","pinyin":"hǎowánr","definitions":["весёлый","интересный"],"example":{"zh":"这个游戏真好玩儿。","py":"zhège yóuxì zhēn hǎowánr。","en":"This game is really fun.","ru":"Эта игра очень весёлая."}},{"simplified":"适应","traditional":"適應","pinyin":"shìyìng","definitions":["приспосабливаться","адаптироваться"],"example":{"zh":"我已经适应这里的生活了。","py":"wǒ yǐjīng shìyìng zhèlǐ de shēnghuó le。","en":"I've already adapted to life here.","ru":"Я уже привык к здешней жизни."}},{"simplified":"健康","traditional":"健康","pinyin":"jiànkāng","definitions":["здоровье","здоровый"],"example":{"zh":"爷爷的身体很健康。","py":"yéye de shēntǐ hěn jiànkāng。","en":"Grandpa is in good health.","ru":"Дедушка совершенно здоров."},"translations":{"tk":["saglyk","sagdyn"]}},{"simplified":"亚洲","traditional":"亞洲","pinyin":"Yàzhōu","definitions":["Азия"],"example":{"zh":"中国在亚洲的东部。","py":"Zhōngguó zài Yàzhōu de dōngbù。","en":"China is in the eastern part of Asia.","ru":"Китай находится в восточной части Азии."}},{"simplified":"非洲","traditional":"非洲","pinyin":"Fēizhōu","definitions":["Африка"],"example":{"zh":"非洲有很多野生动物。","py":"fēizhōu yǒu hěn duō yěshēng dòngwù。","en":"Africa has many wild animals.","ru":"В Африке много диких животных."}},{"simplified":"美洲","traditional":"美洲","pinyin":"Měizhōu","definitions":["Америка"],"example":{"zh":"哥伦布到达了美洲。","py":"Gēlúnbù dàodá le měizhōu。","en":"Columbus reached the Americas.","ru":"Колумб достиг Америки."}},{"simplified":"大洋洲","traditional":"大洋洲","pinyin":"Dàyángzhōu","definitions":["Океания"],"example":{"zh":"大洋洲的动物很特别。","py":"dàyángzhōu de dòngwù hěn tèbié。","en":"The animals of Oceania are very special.","ru":"Животные Океании очень необычны."}},{"simplified":"唐","traditional":"唐","pinyin":"Táng","definitions":["династия Тан","китайский (устар.)"],"example":{"zh":"唐朝的诗歌很有名。","py":"Táng cháo de shīgē hěn yǒumíng。","en":"The poetry of the Tang dynasty is famous.","ru":"Поэзия династии Тан очень знаменита."}}]