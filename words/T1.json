[{"simplified":"画家","traditional":"畫家","pinyin":"huàjiā","definitions":["художник","живописец"],"example":{"zh":"这位画家的作品很有名。","py":"zhè wèi huàjiā de zuòpǐn hěn yǒumíng。","en":"This painter's works are famous.","ru":"Работы этого художника очень известны."}},{"simplified":"孙女","traditional":"孫女","pinyin":"sūnnǚ","definitions":["внучка"],"example":{"zh":"爷爷最疼小孙女。","py":"yéye zuì téng xiǎo sūnnǚ。","en":"Grandpa dotes on his little granddaughter the most.","ru":"Дедушка больше всех любит младшую внучку."}},{"simplified":"树枝","traditional":"樹枝","pinyin":"shùzhī","definitions":["ветка дерева"],"example":{"zh":"小鸟站在树枝上唱歌。","py":"xiǎo niǎo zhàn zài shùzhī shang chànggē。","en":"The little bird sings on the branch.","ru":"Птичка поёт на ветке."}},{"simplified":"树干","traditional":"樹幹","pinyin":"shùgàn","definitions":["ствол дерева"],"example":{"zh":"这棵树的树干很粗。","py":"zhè kē shù de shùgàn hěn cū。","en":"The trunk of this tree is very thick.","ru":"Ствол этого дерева очень толстый."}},{"simplified":"翅膀","traditional":"翅膀","pinyin":"chìbǎng","definitions":["крыло","крылья"],"example":{"zh":"小鸟的翅膀受伤了。","py":"xiǎo niǎo de chìbǎng shòushāng le。","en":"The little bird's wing is injured.","ru":"У птички повреждено крыло."}},{"simplified":"母鸡","traditional":"母雞","pinyin":"mǔjī","definitions":["курица","несушка"],"example":{"zh":"母鸡下了一个蛋。","py":"mǔjī xià le yī ge dàn。","en":"The hen laid an egg.","ru":"Курица снесла яйцо."}},{"simplified":"采访","traditional":"採訪","pinyin":"cǎifǎng","definitions":["брать интервью","посещать для сбора информации"],"example":{"zh":"记者采访了那位老人。","py":"jìzhě cǎifǎng le nà wèi lǎorén。","en":"The reporter interviewed that elderly man.","ru":"Журналист взял интервью у того старика."}},{"simplified":"不停","traditional":"不停","pinyin":"bùtíng","definitions":["без остановки","непрерывно"],"example":{"zh":"雨不停地下了一天。","py":"yǔ bùtíng de xià le yī tiān。","en":"It rained non-stop all day.","ru":"Дождь шёл весь день без остановки."}},{"simplified":"高中","traditional":"高中","pinyin":"gāozhōng","definitions":["старшая школа"],"example":{"zh":"他明年上高中。","py":"tā míngnián shàng gāozhōng。","en":"He starts senior high school next year.","ru":"В следующем году он идёт в старшую школу."}},{"simplified":"没劲儿","traditional":"沒勁兒","pinyin":"méi jìnr","definitions":["скучно","неинтересно"],"example":{"zh":"这个游戏玩久了真没劲儿。","py":"zhège yóuxì wán jiǔ le zhēn méijìnr。","en":"This game gets really boring after a while.","ru":"В эту игру долго играть — скучно."}},{"simplified":"待","traditional":"待","pinyin":"dài","definitions":["ждать","обращаться","пребывать"],"example":{"zh":"你在这儿待一会儿。","py":"nǐ zài zhèr dài yīhuìr。","en":"Stay here for a while.","ru":"Побудь здесь немного."}},{"simplified":"退休","traditional":"退休","pinyin":"tuìxiū","definitions":["уйти на пенсию","пенсионный"],"example":{"zh":"我爸爸明年退休。","py":"wǒ bàba míngnián tuìxiū。","en":"My dad retires next year.","ru":"Мой папа в следующем году выходит на пенсию."}},{"simplified":"操心","traditional":"操心","pinyin":"cāoxīn","definitions":["беспокоиться","заботиться"],"example":{"zh":"这件事你别操心了。","py":"zhè jiàn shì nǐ bié cāoxīn le。","en":"Don't worry about this matter.","ru":"Не беспокойся об этом деле."}},{"simplified":"接受","traditional":"接受","pinyin":"jiēshòu","definitions":["принимать","соглашаться"],"example":{"zh":"他接受了我的礼物。","py":"tā jiēshòu le wǒ de lǐwù。","en":"He accepted my gift.","ru":"Он принял мой подарок."}},{"simplified":"享受","traditional":"享受","pinyin":"xiǎngshòu","definitions":["наслаждаться","пользоваться"],"example":{"zh":"我很享受这个假期。","py":"wǒ hěn xiǎngshòu zhège jiàqī。","en":"I'm really enjoying this holiday.","ru":"Я очень наслаждаюсь этими каникулами."}},{"simplified":"交换","traditional":"交換","pinyin":"jiāohuàn","definitions":["обменивать","обмен"],"example":{"zh":"我们交换了电话号码。","py":"Wǒmen jiāohuàn le diànhuà hàomǎ.","en":"We exchanged phone numbers.","ru":"Мы обменялись номерами телефонов."}},{"simplified":"人生","traditional":"人生","pinyin":"rénshēng","definitions":["жизнь","человеческая жизнь"],"example":{"zh":"人生只有一次。","py":"rénshēng zhǐ yǒu yí cì。","en":"You only get one life.","ru":"Жизнь бывает только одна."}},{"simplified":"富翁","traditional":"富翁","pinyin":"fùwēng","definitions":["богач","магнат"],"example":{"zh":"他成了有名的富翁。","py":"tā chéng le yǒumíng de fùwēng。","en":"He became a famous rich man.","ru":"Он стал известным богачом."}},{"simplified":"羡慕","traditional":"羨慕","pinyin":"xiànmù","definitions":["завидовать","восхищаться"],"example":{"zh":"我很羡慕你的工作。","py":"wǒ hěn xiànmù nǐ de gōngzuò。","en":"I really envy your job.","ru":"Я очень завидую твоей работе."}},{"simplified":"放弃","traditional":"放棄","pinyin":"fàngqì","definitions":["отказываться","бросать"],"example":{"zh":"别放弃，再试一次。","py":"bié fàngqì，zài shì yí cì。","en":"Don't give up, try once more.","ru":"Не сдавайся, попробуй ещё раз."}},{"simplified":"大脑","traditional":"大腦","pinyin":"dànǎo","definitions":["мозг"],"example":{"zh":"睡眠让大脑得到休息。","py":"shuìmián ràng dànǎo dédào xiūxi。","en":"Sleep lets the brain rest.","ru":"Сон даёт мозгу отдохнуть."}},{"simplified":"提出","traditional":"提出","pinyin":"tíchū","definitions":["предлагать","выдвигать (идею)"],"example":{"zh":"他提出了一个好建议。","py":"tā tíchū le yī ge hǎo jiànyì。","en":"He put forward a good suggestion.","ru":"Он внёс хорошее предложение."}},{"simplified":"富有","traditional":"富有","pinyin":"fùyǒu","definitions":["богатый","состоятельный"],"example":{"zh":"他家很富有。","py":"tā jiā hěn fùyǒu。","en":"His family is very wealthy.","ru":"Его семья очень богата."}},{"simplified":"手术","traditional":"手術","pinyin":"shǒushù","definitions":["операция (хирургическая)","хирургия"],"example":{"zh":"他昨天做了手术。","py":"tā zuótiān zuò le shǒushù。","en":"He had an operation yesterday.","ru":"Ему вчера сделали операцию."}},{"simplified":"动脑子","traditional":"動腦子","pinyin":"dòng nǎozi","definitions":["думать","шевелить мозгами"],"example":{"zh":"做题要多动脑子。","py":"zuò tí yào duō dòngnǎozi。","en":"Use your brain more when solving problems.","ru":"Решая задачи, нужно больше шевелить мозгами."}},{"simplified":"无忧无虑","traditional":"無憂無慮","pinyin":"wúyōu wúlǜ","definitions":["беззаботный","свободный от забот"],"example":{"zh":"孩子们过得无忧无虑。","py":"Háizimen guò de wúyōuwúlǜ.","en":"The children live free of any worries.","ru":"Дети живут беззаботно."}},{"simplified":"不知不觉","traditional":"不知不覺","pinyin":"bùzhī bùjué","definitions":["неосознанно","незаметно"],"example":{"zh":"不知不觉天就黑了。","py":"bùzhībùjué tiān jiù hēi le。","en":"Before we knew it, it was dark.","ru":"Незаметно стемнело."}}]