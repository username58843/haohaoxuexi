[{"simplified":"外貌","traditional":"外貌","pinyin":"wàimào","definitions":["внешность","внешний вид"],"example":{"zh":"不要只看人的外貌。","py":"bùyào zhǐ kàn rén de wàimào。","en":"Don't judge people only by their looks.","ru":"Не суди о людях только по внешности."}},{"simplified":"描写","traditional":"描寫","pinyin":"miáoxiě","definitions":["описывать","изображать"],"example":{"zh":"这本书描写了农村生活。","py":"Zhè běn shū miáoxiě le nóngcūn shēnghuó.","en":"This book describes life in the countryside.","ru":"Эта книга описывает жизнь в деревне."}},{"simplified":"自我","traditional":"自我","pinyin":"zìwǒ","definitions":["себя","эго","самосознание"],"example":{"zh":"要学会自我管理。","py":"yào xuéhuì zìwǒ guǎnlǐ。","en":"Learn to manage yourself.","ru":"Нужно научиться самоорганизации."}},{"simplified":"彼此","traditional":"彼此","pinyin":"bǐcǐ","definitions":["друг другу","взаимно"],"example":{"zh":"我们应该彼此帮助。","py":"wǒmen yīnggāi bǐcǐ bāngzhù。","en":"We should help each other.","ru":"Мы должны помогать друг другу."}},{"simplified":"填写","traditional":"填寫","pinyin":"tiánxiě","definitions":["заполнять","вписывать"],"example":{"zh":"请填写这张申请表。","py":"qǐng tiánxiě zhè zhāng shēnqǐngbiǎo。","en":"Please fill in this application form.","ru":"Заполните, пожалуйста, эту анкету."}},{"simplified":"性别","traditional":"性別","pinyin":"xìngbié","definitions":["пол","гендер"],"example":{"zh":"请填写你的性别。","py":"qǐng tiánxiě nǐ de xìngbié。","en":"Please fill in your gender.","ru":"Пожалуйста, укажите свой пол."}},{"simplified":"开朗","traditional":"開朗","pinyin":"kāilǎng","definitions":["открытый","жизнерадостный"],"example":{"zh":"她的性格很开朗。","py":"tā de xìnggé hěn kāilǎng。","en":"She has a cheerful personality.","ru":"У неё открытый, весёлый характер."}},{"simplified":"害羞","traditional":"害羞","pinyin":"hàixiū","definitions":["застенчивый","стеснительный"],"example":{"zh":"这个孩子很害羞。","py":"zhège háizi hěn hàixiū。","en":"This child is very shy.","ru":"Этот ребёнок очень стеснительный."}},{"simplified":"帅","traditional":"帥","pinyin":"shuài","definitions":["красивый (о мужчинах)","крутой"],"example":{"zh":"他今天穿得很帅。","py":"tā jīntiān chuān de hěn shuài。","en":"He's dressed very handsomely today.","ru":"Он сегодня очень стильно одет."}},{"simplified":"不止","traditional":"不止","pinyin":"bùzhǐ","definitions":["не только","более чем"],"example":{"zh":"来的人不止十个。","py":"lái de rén bùzhǐ shí gè。","en":"More than ten people came.","ru":"Пришло больше десяти человек."}},{"simplified":"填表","traditional":"填表","pinyin":"tián biǎo","definitions":["заполнять форму","заполнять бланк"],"example":{"zh":"办签证要先填表。","py":"bàn qiānzhèng yào xiān tiánbiǎo。","en":"To get a visa you first fill out a form.","ru":"Для визы сначала нужно заполнить анкету."}},{"simplified":"活泼开朗","traditional":"活潑開朗","pinyin":"huópō kāilǎng","definitions":["жизнерадостный и открытый"],"example":{"zh":"她是个活泼开朗的女孩。","py":"tā shì ge huópōkāilǎng de nǚhái。","en":"She is a lively and cheerful girl.","ru":"Она живая и жизнерадостная девочка."}},{"simplified":"表","traditional":"表","pinyin":"biǎo","definitions":["таблица","форма","выражать"],"example":{"zh":"把数据填进这张表。","py":"bǎ shùjù tián jìn zhè zhāng biǎo。","en":"Enter the data into this table.","ru":"Внесите данные в эту таблицу."}},{"simplified":"特点","traditional":"特點","pinyin":"tèdiǎn","definitions":["особенность","характерная черта"],"example":{"zh":"这个城市有什么特点？","py":"zhège chéngshì yǒu shénme tèdiǎn？","en":"What are the special features of this city?","ru":"Какие особенности у этого города?"}},{"simplified":"通讯录","traditional":"通訊錄","pinyin":"tōngxùnlù","definitions":["адресная книга","контакты"],"example":{"zh":"他的号码在我的通讯录里。","py":"tā de hàomǎ zài wǒ de tōngxùnlù li。","en":"His number is in my contacts.","ru":"Его номер есть в моей адресной книге."}},{"simplified":"作文","traditional":"作文","pinyin":"zuòwén","definitions":["сочинение","эссе"],"example":{"zh":"老师让我们写一篇作文。","py":"lǎoshī ràng wǒmen xiě yì piān zuòwén。","en":"The teacher asked us to write an essay.","ru":"Учитель попросил нас написать сочинение."}},{"simplified":"卷子","traditional":"卷子","pinyin":"juànzi","definitions":["экзаменационная работа","тестовая тетрадь"],"example":{"zh":"老师正在改卷子。","py":"lǎoshī zhèngzài gǎi juànzi。","en":"The teacher is grading the test papers.","ru":"Учитель проверяет контрольные работы."}}]