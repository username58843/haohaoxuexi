[{"simplified":"理想","traditional":"理想","pinyin":"lǐxiǎng","definitions":["идеал","мечта","совершенный"],"example":{"zh":"我的理想是当老师。","py":"wǒ de lǐxiǎng shì dāng lǎoshī。","en":"My dream is to become a teacher.","ru":"Моя мечта — стать учителем."}},{"simplified":"专业","traditional":"專業","pinyin":"zhuānyè","definitions":["профессия","специальность","профессиональный"],"example":{"zh":"我的专业是历史。","py":"wǒ de zhuānyè shì lìshǐ。","en":"My major is history.","ru":"Моя специальность — история."}},{"simplified":"当时","traditional":"當時","pinyin":"dāngshí","definitions":["в то время","тогда"],"example":{"zh":"当时我不在家。","py":"dāngshí wǒ bú zài jiā。","en":"At that time I wasn't home.","ru":"В то время меня не было дома."}},{"simplified":"赞成","traditional":"贊成","pinyin":"zànchéng","definitions":["соглашаться","поддерживать","одобрять"],"example":{"zh":"我赞成你的看法。","py":"wǒ zànchéng nǐ de kànfǎ。","en":"I agree with your view.","ru":"Я одобряю твою точку зрения."}},{"simplified":"系","traditional":"系","pinyin":"xì","definitions":["факультет","отделение","система"],"example":{"zh":"他是中文系的学生。","py":"tā shì zhōngwén xì de xuésheng。","en":"He is a student of the Chinese department.","ru":"Он студент факультета китайского языка."}},{"simplified":"著名","traditional":"著名","pinyin":"zhùmíng","definitions":["известный","знаменитый"],"example":{"zh":"他是一位著名的作家。","py":"tā shì yí wèi zhùmíng de zuòjiā。","en":"He is a famous writer.","ru":"Он известный писатель."}},{"simplified":"旅途","traditional":"旅途","pinyin":"lǚtú","definitions":["путешествие","дорога"],"example":{"zh":"旅途中他认识了很多朋友。","py":"lǚtú zhōng tā rènshi le hěn duō péngyou。","en":"He made many friends during the journey.","ru":"В пути он завёл много друзей."}},{"simplified":"宾馆","traditional":"賓館","pinyin":"bīnguǎn","definitions":["гостиница","отель"],"example":{"zh":"我们住在这家宾馆。","py":"wǒmen zhù zài zhè jiā bīnguǎn。","en":"We are staying at this hotel.","ru":"Мы живём в этой гостинице."},"translations":{"tk":["myhmanhana"]}},{"simplified":"地图","traditional":"地圖","pinyin":"dìtú","definitions":["карта","план местности"],"example":{"zh":"请给我一张地图。","py":"qǐng gěi wǒ yì zhāng dìtú。","en":"Please give me a map.","ru":"Дайте мне, пожалуйста, карту."},"translations":{"tk":["karta"]}},{"simplified":"对面","traditional":"對面","pinyin":"duìmiàn","definitions":["напротив","противоположная сторона"],"example":{"zh":"银行就在对面。","py":"yínháng jiù zài duìmiàn。","en":"The bank is right across the street.","ru":"Банк как раз напротив."}},{"simplified":"好像","traditional":"好像","pinyin":"hǎoxiàng","definitions":["кажется","похоже"],"example":{"zh":"他好像有点不高兴。","py":"tā hǎoxiàng yǒudiǎn bù gāoxìng。","en":"He seems a bit unhappy.","ru":"Он, кажется, немного расстроен."}},{"simplified":"心事","traditional":"心事","pinyin":"xīnshì","definitions":["забота","мысль","переживание"],"example":{"zh":"她好像有心事。","py":"tā hǎoxiàng yǒu xīnshì。","en":"She seems to have something on her mind.","ru":"Похоже, её что-то тревожит."}},{"simplified":"交谈","traditional":"交談","pinyin":"jiāotán","definitions":["беседовать","разговаривать"],"example":{"zh":"他们愉快地交谈起来。","py":"tāmen yúkuài de jiāotán qǐlái。","en":"They started chatting pleasantly.","ru":"Они завели приятную беседу."}},{"simplified":"所","traditional":"所","pinyin":"suǒ","definitions":["место","то, что","используется как грамматический элемент"],"example":{"zh":"这所学校很有名。","py":"zhè suǒ xuéxiào hěn yǒumíng。","en":"This school is very famous.","ru":"Эта школа очень известная."}},{"simplified":"简直","traditional":"簡直","pinyin":"jiǎnzhí","definitions":["просто","совершенно","буквально"],"example":{"zh":"这个消息简直太好了。","py":"Zhège xiāoxi jiǎnzhí tài hǎo le.","en":"This news is simply wonderful.","ru":"Эта новость просто замечательная."}},{"simplified":"分别","traditional":"分別","pinyin":"fēnbié","definitions":["расставание","разделение","отдельно"],"example":{"zh":"我们在车站分别了。","py":"wǒmen zài chēzhàn fēnbié le。","en":"We parted at the station.","ru":"Мы расстались на вокзале."}},{"simplified":"彩虹","traditional":"彩虹","pinyin":"cǎihóng","definitions":["радуга"],"example":{"zh":"雨后天上出现了彩虹。","py":"yǔ hòu tiānshàng chūxiàn le cǎihóng。","en":"After the rain a rainbow appeared in the sky.","ru":"После дождя в небе появилась радуга."}},{"simplified":"意义","traditional":"意義","pinyin":"yìyì","definitions":["значение","смысл"],"example":{"zh":"这份工作很有意义。","py":"zhè fèn gōngzuò hěn yǒu yìyì。","en":"This job is very meaningful.","ru":"Эта работа очень значимая."}},{"simplified":"风雨","traditional":"風雨","pinyin":"fēngyǔ","definitions":["ветер и дождь","невзгоды","испытания"],"example":{"zh":"他们一起经历了许多风雨。","py":"tāmen yīqǐ jīnglì le xǔduō fēngyǔ。","en":"They weathered many storms together.","ru":"Они вместе пережили немало бурь."}},{"simplified":"成功","traditional":"成功","pinyin":"chénggōng","definitions":["успех","успешный"],"example":{"zh":"我相信你一定会成功。","py":"wǒ xiāngxìn nǐ yídìng huì chénggōng。","en":"I believe you will definitely succeed.","ru":"Я верю, что у тебя обязательно получится."}},{"simplified":"从","traditional":"從","pinyin":"cóng","definitions":["из","от","с"],"example":{"zh":"我从中国来。","py":"wǒ cóng Zhōngguó lái。","en":"I come from China.","ru":"Я из Китая."},"translations":{"tk":["-dan/-den (başlap)"]}},{"simplified":"酸甜苦辣","traditional":"酸甜苦辣","pinyin":"suāntiánkǔlà","definitions":["кислый, сладкий, горький, острый","все вкусы жизни","радости и горести"],"example":{"zh":"生活充满酸甜苦辣。","py":"shēnghuó chōngmǎn suāntiánkǔlà。","en":"Life is full of all kinds of flavors — sweet and bitter.","ru":"В жизни всего хватает — и сладкого, и горького."}},{"simplified":"段","traditional":"段","pinyin":"duàn","definitions":["отрезок","часть","сегмент"],"example":{"zh":"我走了一段路。","py":"wǒ zǒu le yí duàn lù。","en":"I walked a stretch of road.","ru":"Я прошёл часть пути."},"translations":{"tk":["bölek","abzas"]}},{"simplified":"梦","traditional":"夢","pinyin":"mèng","definitions":["сон","мечта"],"example":{"zh":"我昨晚做了一个梦。","py":"wǒ zuó wǎn zuò le yī ge mèng。","en":"I had a dream last night.","ru":"Прошлой ночью мне снился сон."}},{"simplified":"亲人","traditional":"親人","pinyin":"qīnrén","definitions":["родственник","близкий человек"],"example":{"zh":"过节最想念亲人。","py":"guòjié zuì xiǎngniàn qīnrén。","en":"During holidays we miss our family most.","ru":"В праздники больше всего скучаешь по родным."}},{"simplified":"女儿","traditional":"女兒","pinyin":"nǚ’ér","definitions":["дочь"],"example":{"zh":"他的女儿很漂亮。","py":"tā de nǚ'ér hěn piàoliang。","en":"His daughter is very pretty.","ru":"Его дочь очень красивая."},"translations":{"tk":["gyz (perzent)"]}},{"simplified":"失败","traditional":"失敗","pinyin":"shībài","definitions":["неудача","провал"],"example":{"zh":"这次考试他失败了。","py":"zhè cì kǎoshì tā shībài le。","en":"He failed this exam.","ru":"На этом экзамене он потерпел неудачу."}},{"simplified":"失去","traditional":"失去","pinyin":"shīqù","definitions":["терять","лишаться"],"example":{"zh":"他失去了这个机会。","py":"tā shīqù le zhège jīhuì。","en":"He lost this opportunity.","ru":"Он упустил эту возможность."}},{"simplified":"信心","traditional":"信心","pinyin":"xìnxīn","definitions":["уверенность","вера"],"example":{"zh":"我对考试有信心。","py":"wǒ duì kǎoshì yǒu xìnxīn。","en":"I'm confident about the exam.","ru":"Я уверен, что сдам экзамен."}},{"simplified":"选择","traditional":"選擇","pinyin":"xuǎnzé","definitions":["выбирать","выбор"],"example":{"zh":"你可以自己选择。","py":"nǐ kěyǐ zìjǐ xuǎnzé。","en":"You can choose for yourself.","ru":"Ты можешь выбрать сам."},"translations":{"tk":["saýlamak","seçim"]}},{"simplified":"道路","traditional":"道路","pinyin":"dàolù","definitions":["дорога","путь"],"example":{"zh":"这条道路通向山顶。","py":"zhè tiáo dàolù tōngxiàng shāndǐng。","en":"This road leads to the mountaintop.","ru":"Эта дорога ведёт на вершину горы."}},{"simplified":"人生","traditional":"人生","pinyin":"rénshēng","definitions":["жизнь","человеческая жизнь"],"example":{"zh":"人生只有一次。","py":"rénshēng zhǐ yǒu yí cì。","en":"You only get one life.","ru":"Жизнь бывает только одна."}},{"simplified":"退缩","traditional":"退縮","pinyin":"tuìsuō","definitions":["отступать","сдаваться"],"example":{"zh":"遇到困难他从不退缩。","py":"yùdào kùnnan tā cóng bù tuìsuō。","en":"He never shrinks back from difficulties.","ru":"Перед трудностями он никогда не отступает."}},{"simplified":"取得","traditional":"取得","pinyin":"qǔdé","definitions":["достигать","получать"],"example":{"zh":"她取得了很大的进步。","py":"tā qǔdé le hěn dà de jìnbù。","en":"She has made great progress.","ru":"Она добилась больших успехов."}},{"simplified":"鼓励","traditional":"鼓勵","pinyin":"gǔlì","definitions":["поощрять","поддерживать"],"example":{"zh":"老师鼓励我多说话。","py":"lǎoshī gǔlì wǒ duō shuōhuà。","en":"The teacher encourages me to speak more.","ru":"Учитель поощряет меня больше говорить."}},{"simplified":"梦想","traditional":"夢想","pinyin":"mèngxiǎng","definitions":["мечта"," aspiration"],"example":{"zh":"我的梦想是当医生。","py":"Wǒ de mèngxiǎng shì dāng yīshēng.","en":"My dream is to become a doctor.","ru":"Моя мечта — стать врачом."}},{"simplified":"可笑","traditional":"可笑","pinyin":"kěxiào","definitions":["смешной","нелепый"],"example":{"zh":"他讲的故事真可笑。","py":"tā jiǎng de gùshi zhēn kěxiào。","en":"The story he told was really funny.","ru":"История, которую он рассказал, очень смешная."}},{"simplified":"坚强","traditional":"堅強","pinyin":"jiānqiáng","definitions":["сильный","стойкий"],"example":{"zh":"她是个坚强的女孩。","py":"Tā shì ge jiānqiáng de nǚhái.","en":"She is a strong girl.","ru":"Она сильная девочка."}},{"simplified":"付出","traditional":"付出","pinyin":"fùchū","definitions":["отдавать","прилагать усилия"],"example":{"zh":"成功需要付出努力。","py":"chénggōng xūyào fùchū nǔlì。","en":"Success requires effort.","ru":"Успех требует усилий."}},{"simplified":"艰苦","traditional":"艱苦","pinyin":"jiānkǔ","definitions":["трудный","суровый","тяжёлый"],"example":{"zh":"他们的生活很艰苦。","py":"Tāmen de shēnghuó hěn jiānkǔ.","en":"Their life is very hard.","ru":"Их жизнь очень тяжёлая."}},{"simplified":"南京","traditional":"南京","pinyin":"Nánjīng","definitions":["Нанкин (город в Китае)"],"example":{"zh":"南京是一座历史名城。","py":"Nánjīng shì yī zuò lìshǐ míngchéng。","en":"Nanjing is a famous historical city.","ru":"Нанкин — знаменитый исторический город."}}]