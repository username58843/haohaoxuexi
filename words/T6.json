[{"simplified":"陪伴","traditional":"陪伴","pinyin":"péibàn","definitions":["сопровождать","быть рядом","компания"],"example":{"zh":"这只狗陪伴了他十年。","py":"zhè zhī gǒu péibàn le tā shí nián。","en":"This dog has been his companion for ten years.","ru":"Эта собака была с ним рядом десять лет."}},{"simplified":"括号","traditional":"括號","pinyin":"kuòhào","definitions":["скобки"],"example":{"zh":"把答案写在括号里。","py":"bǎ dáàn xiě zài kuòhào li。","en":"Write the answer in the brackets.","ru":"Впишите ответ в скобки."}},{"simplified":"赚","traditional":"賺","pinyin":"zhuàn","definitions":["зарабатывать","получать прибыль"],"example":{"zh":"他一个月赚不少钱。","py":"tā yí ge yuè zhuàn bù shǎo qián。","en":"He earns quite a lot of money in a month.","ru":"Он зарабатывает немало за месяц."}},{"simplified":"毫无","traditional":"毫無","pinyin":"háowú","definitions":["совершенно не","нисколько"],"example":{"zh":"他毫无准备就来了。","py":"Tā háowú zhǔnbèi jiù lái le.","en":"He came completely unprepared.","ru":"Он пришёл совершенно неподготовленным."}},{"simplified":"玩具","traditional":"玩具","pinyin":"wánjù","definitions":["игрушка"],"example":{"zh":"弟弟有很多玩具。","py":"dìdi yǒu hěn duō wánjù。","en":"My little brother has a lot of toys.","ru":"У младшего брата много игрушек."}},{"simplified":"自私","traditional":"自私","pinyin":"zìsī","definitions":["эгоистичный","себялюбивый"],"example":{"zh":"他这个人有点自私。","py":"tā zhège rén yǒudiǎn zìsī。","en":"He's a bit selfish.","ru":"Он немного эгоистичен."}},{"simplified":"一天到晚","traditional":"一天到晚","pinyin":"yītiān dào wǎn","definitions":["весь день напролёт","круглые сутки"],"example":{"zh":"他一天到晚玩手机。","py":"tā yītiāndàowǎn wán shǒujī。","en":"He is on his phone all day long.","ru":"Он весь день напролёт сидит в телефоне."}},{"simplified":"凶","traditional":"兇","pinyin":"xiōng","definitions":["свирепый","жестокий","злой"],"example":{"zh":"别对孩子那么凶。","py":"bié duì háizi nàme xiōng。","en":"Don't be so fierce with the child.","ru":"Не будь так суров с ребёнком."}},{"simplified":"再说","traditional":"再說","pinyin":"zàishuō","definitions":["кроме того","далее","снова говорить"],"example":{"zh":"太晚了，这事明天再说。","py":"tài wǎn le，zhè shì míngtiān zàishuō。","en":"It's too late — let's discuss this tomorrow.","ru":"Уже поздно, обсудим это завтра."}},{"simplified":"枕头","traditional":"枕頭","pinyin":"zhěntou","definitions":["подушка"],"example":{"zh":"这个枕头很软很舒服。","py":"zhège zhěntou hěn ruǎn hěn shūfu。","en":"This pillow is soft and comfortable.","ru":"Эта подушка мягкая и удобная."}},{"simplified":"皱巴巴","traditional":"皺巴巴","pinyin":"zhòubābā","definitions":["смятый","помятый","морщинистый"],"example":{"zh":"他的衬衫皱巴巴的。","py":"tā de chènshān zhòubābā de。","en":"His shirt is all wrinkled.","ru":"Его рубашка вся мятая."}},{"simplified":"钞票","traditional":"鈔票","pinyin":"chāopiào","definitions":["банкнота","деньги","купюра"],"example":{"zh":"他数了数手里的钞票。","py":"Tā shǔ le shǔ shǒu lǐ de chāopiào.","en":"He counted the banknotes in his hand.","ru":"Он пересчитал банкноты в руке."}},{"simplified":"合适","traditional":"合適","pinyin":"héshì","definitions":["подходящий","уместный"],"example":{"zh":"这双鞋很合适。","py":"zhè shuāng xié hěn héshì。","en":"These shoes fit well.","ru":"Эти туфли хорошо подходят."}},{"simplified":"辛苦","traditional":"辛苦","pinyin":"xīnkǔ","definitions":["трудный","утомительный","тяжёлый труд"],"example":{"zh":"妈妈工作很辛苦。","py":"māma gōngzuò hěn xīnkǔ。","en":"Mom works very hard.","ru":"Мама очень тяжело работает."}},{"simplified":"判断","traditional":"判斷","pinyin":"pànduàn","definitions":["судить","оценивать","принимать решение"],"example":{"zh":"很难判断谁说得对。","py":"hěn nán pànduàn shéi shuō de duì。","en":"It's hard to judge who is right.","ru":"Трудно определить, кто прав."}},{"simplified":"正误","traditional":"正誤","pinyin":"zhèngwù","definitions":["правильность и ошибка","верно или неверно"],"example":{"zh":"请判断句子的正误。","py":"qǐng pànduàn jùzi de zhèngwù。","en":"Please judge whether the sentences are right or wrong.","ru":"Определите, верны ли предложения."}},{"simplified":"向","traditional":"向","pinyin":"xiàng","definitions":["по направлению к","к","в сторону"],"example":{"zh":"他向我走过来。","py":"tā xiàng wǒ zǒu guòlái。","en":"He walked over toward me.","ru":"Он подошёл ко мне."},"translations":{"tk":["tarap","-a/-e garşy"]}},{"simplified":"并","traditional":"並","pinyin":"bìng","definitions":["и","а также","параллельно"],"example":{"zh":"他并不知道这件事。","py":"tā bìng bù zhīdào zhè jiàn shì。","en":"He actually doesn't know about this.","ru":"Он вовсе не знает об этом."}},{"simplified":"借","traditional":"借","pinyin":"jiè","definitions":["занимать","одалживать","брать взаймы"],"example":{"zh":"我可以借你的书吗？","py":"wǒ kěyǐ jiè nǐ de shū ma？","en":"May I borrow your book?","ru":"Можно я возьму твою книгу?"},"translations":{"tk":["karz almak","karz bermek"]}},{"simplified":"一顿饭","traditional":"一頓飯","pinyin":"yīdùnfàn","definitions":["один приём пищи","одна трапеза"],"example":{"zh":"我们一起吃了一顿饭。","py":"wǒmen yīqǐ chī le yīdùnfàn。","en":"We had a meal together.","ru":"Мы вместе пообедали."}},{"simplified":"坚持","traditional":"堅持","pinyin":"jiānchí","definitions":["настаивать","упорствовать","придерживаться"],"example":{"zh":"他每天坚持跑步。","py":"tā měitiān jiānchí pǎobù。","en":"He keeps running every day.","ru":"Он каждый день упорно бегает."}},{"simplified":"理由","traditional":"理由","pinyin":"lǐyóu","definitions":["причина","основание","довод"],"example":{"zh":"你有什么理由？","py":"Nǐ yǒu shénme lǐyóu?","en":"What reason do you have?","ru":"Какая у тебя причина?"}},{"simplified":"一个结尾","traditional":"一個結尾","pinyin":"yīgè jiéwěi","definitions":["один финал","одно завершение"],"example":{"zh":"给故事写一个结尾。","py":"gěi gùshi xiě yīgèjiéwěi。","en":"Write an ending for the story.","ru":"Напишите концовку для рассказа."}},{"simplified":"庆祝","traditional":"慶祝","pinyin":"qìngzhù","definitions":["праздновать","отмечать"],"example":{"zh":"我们一起庆祝她的生日。","py":"wǒmen yìqǐ qìngzhù tā de shēngrì。","en":"We are celebrating her birthday together.","ru":"Мы вместе празднуем её день рождения."}},{"simplified":"不仅，而且","traditional":"不僅，而且","pinyin":"bùjǐn, érqiě","definitions":["не только, но и"],"example":{"zh":"她不仅聪明，而且努力。","py":"tā bùjǐn cōngming，érqiě nǔlì。","en":"She is not only smart but also hardworking.","ru":"Она не только умна, но и трудолюбива."}}]