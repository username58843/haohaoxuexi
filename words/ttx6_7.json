[{"simplified":"赚","traditional":"賺","pinyin":"zhuàn","definitions":["зарабатывать","получать прибыль"],"example":{"zh":"他一个月赚不少钱。","py":"tā yí ge yuè zhuàn bù shǎo qián。","en":"He earns quite a lot of money in a month.","ru":"Он зарабатывает немало за месяц."}},{"simplified":"毫无","traditional":"毫無","pinyin":"háowú","definitions":["совершенно не","нисколько"],"example":{"zh":"他毫无准备就来了。","py":"Tā háowú zhǔnbèi jiù lái le.","en":"He came completely unprepared.","ru":"Он пришёл совершенно неподготовленным."}},{"simplified":"玩具","traditional":"玩具","pinyin":"wánjù","definitions":["игрушка"],"example":{"zh":"弟弟有很多玩具。","py":"dìdi yǒu hěn duō wánjù。","en":"My little brother has a lot of toys.","ru":"У младшего брата много игрушек."}},{"simplified":"自私","traditional":"自私","pinyin":"zìsī","definitions":["эгоистичный","себялюбивый"],"example":{"zh":"他这个人有点自私。","py":"tā zhège rén yǒudiǎn zìsī。","en":"He's a bit selfish.","ru":"Он немного эгоистичен."}},{"simplified":"一天到晚","traditional":"一天到晚","pinyin":"yītiān dào wǎn","definitions":["весь день напролёт","круглые сутки"],"example":{"zh":"他一天到晚玩手机。","py":"tā yītiāndàowǎn wán shǒujī。","en":"He is on his phone all day long.","ru":"Он весь день напролёт сидит в телефоне."}},{"simplified":"凶","traditional":"兇","pinyin":"xiōng","definitions":["свирепый","жестокий","злой"],"example":{"zh":"别对孩子那么凶。","py":"bié duì háizi nàme xiōng。","en":"Don't be so fierce with the child.","ru":"Не будь так суров с ребёнком."}},{"simplified":"再说","traditional":"再說","pinyin":"zàishuō","definitions":["кроме того","далее","снова говорить"],"example":{"zh":"太晚了，这事明天再说。","py":"tài wǎn le，zhè shì míngtiān zàishuō。","en":"It's too late — let's discuss this tomorrow.","ru":"Уже поздно, обсудим это завтра."}},{"simplified":"枕头","traditional":"枕頭","pinyin":"zhěntou","definitions":["подушка"],"example":{"zh":"这个枕头很软很舒服。","py":"zhège zhěntou hěn ruǎn hěn shūfu。","en":"This pillow is soft and comfortable.","ru":"Эта подушка мягкая и удобная."}},{"simplified":"皱巴巴","traditional":"皺巴巴","pinyin":"zhòubābā","definitions":["смятый","помятый","морщинистый"],"example":{"zh":"他的衬衫皱巴巴的。","py":"tā de chènshān zhòubābā de。","en":"His shirt is all wrinkled.","ru":"Его рубашка вся мятая."}},{"simplified":"钞票","traditional":"鈔票","pinyin":"chāopiào","definitions":["банкнота","деньги","купюра"],"example":{"zh":"他数了数手里的钞票。","py":"Tā shǔ le shǔ shǒu lǐ de chāopiào.","en":"He counted the banknotes in his hand.","ru":"Он пересчитал банкноты в руке."}},{"simplified":"医学","traditional":"醫學","pinyin":"yīxué","definitions":["медицина","медицинская наука"],"example":{"zh":"她在大学学医学。","py":"tā zài dàxué xué yīxué。","en":"She studies medicine at university.","ru":"Она изучает медицину в университете."}},{"simplified":"肺病","traditional":"肺病","pinyin":"fèibìng","definitions":["болезнь лёгких","туберкулёз"],"example":{"zh":"爷爷得过肺病。","py":"yéye dé guo fèibìng。","en":"Grandpa once had a lung disease.","ru":"Дедушка когда-то болел лёгкими."}},{"simplified":"妇科","traditional":"婦科","pinyin":"fùkē","definitions":["гинекология"],"example":{"zh":"她是妇科医生。","py":"tā shì fùkē yīshēng。","en":"She is a gynecologist.","ru":"Она врач-гинеколог."}},{"simplified":"诊断","traditional":"診斷","pinyin":"zhěnduàn","definitions":["диагностика","диагностировать"],"example":{"zh":"医生诊断他得了感冒。","py":"yīshēng zhěnduàn tā dé le gǎnmào。","en":"The doctor diagnosed him with a cold.","ru":"Врач диагностировал у него простуду."}},{"simplified":"脉搏","traditional":"脈搏","pinyin":"màibó","definitions":["пульс"],"example":{"zh":"他的脉搏跳得很快。","py":"Tā de màibó tiào de hěn kuài.","en":"His pulse is beating very fast.","ru":"Его пульс бьётся очень часто."}},{"simplified":"无论如何","traditional":"無論如何","pinyin":"wúlùn rúhé","definitions":["в любом случае","несмотря ни на что"],"example":{"zh":"无论如何你都要来。","py":"wúlùnrúhé nǐ dōu yào lái。","en":"You must come no matter what.","ru":"Ты должен прийти во что бы то ни стало."}},{"simplified":"浑身","traditional":"渾身","pinyin":"húnshēn","definitions":["всё тело","целиком"],"example":{"zh":"他浑身都是汗。","py":"Tā húnshēn dōu shì hàn.","en":"He was covered in sweat from head to foot.","ru":"Он весь был в поту."}},{"simplified":"药方","traditional":"藥方","pinyin":"yàofāng","definitions":["рецепт","прописанное лекарство"],"example":{"zh":"医生开了一张药方。","py":"yīshēng kāi le yī zhāng yàofāng。","en":"The doctor wrote a prescription.","ru":"Врач выписал рецепт."}},{"simplified":"顾不上","traditional":"顧不上","pinyin":"gùbùshàng","definitions":["не иметь времени на","быть слишком занятым для"],"example":{"zh":"他忙得顾不上休息。","py":"tā máng de gùbùshàng xiūxi。","en":"He is too busy to rest.","ru":"Он так занят, что ему не до отдыха."}},{"simplified":"药店","traditional":"藥店","pinyin":"yàodiàn","definitions":["аптека"],"example":{"zh":"药店就在医院对面。","py":"yàodiàn jiù zài yīyuàn duìmiàn。","en":"The pharmacy is right across from the hospital.","ru":"Аптека прямо напротив больницы."}},{"simplified":"匆匆","traditional":"匆匆","pinyin":"cōngcōng","definitions":["в спешке","торопливо"],"example":{"zh":"他匆匆吃了饭就走了。","py":"tā cōngcōng chī le fàn jiù zǒu le。","en":"He ate hurriedly and left.","ru":"Он наспех поел и ушёл."}},{"simplified":"店员","traditional":"店員","pinyin":"diànyuán","definitions":["продавец","работник магазина"],"example":{"zh":"店员热情地接待顾客。","py":"diànyuán rèqíng de jiēdài gùkè。","en":"The shop assistant welcomed the customers warmly.","ru":"Продавец радушно встречал покупателей."}}]