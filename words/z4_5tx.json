[{"simplified":"理想","traditional":"理想","pinyin":"lǐxiǎng","definitions":["идеал","мечта","совершенный"],"example":{"zh":"我的理想是当老师。","py":"wǒ de lǐxiǎng shì dāng lǎoshī。","en":"My dream is to become a teacher.","ru":"Моя мечта — стать учителем."}},{"simplified":"专业","traditional":"專業","pinyin":"zhuānyè","definitions":["профессия","специальность","профессиональный"],"example":{"zh":"我的专业是历史。","py":"wǒ de zhuānyè shì lìshǐ。","en":"My major is history.","ru":"Моя специальность — история."}},{"simplified":"当时","traditional":"當時","pinyin":"dāngshí","definitions":["в то время","тогда"],"example":{"zh":"当时我不在家。","py":"dāngshí wǒ bú zài jiā。","en":"At that time I wasn't home.","ru":"В то время меня не было дома."}},{"simplified":"赞成","traditional":"贊成","pinyin":"zànchéng","definitions":["соглашаться","поддерживать","одобрять"],"example":{"zh":"我赞成你的看法。","py":"wǒ zànchéng nǐ de kànfǎ。","en":"I agree with your view.","ru":"Я одобряю твою точку зрения."}},{"simplified":"系","traditional":"系","pinyin":"xì","definitions":["факультет","отделение","система"],"example":{"zh":"他是中文系的学生。","py":"tā shì zhōngwén xì de xuésheng。","en":"He is a student of the Chinese department.","ru":"Он студент факультета китайского языка."}},{"simplified":"著名","traditional":"著名","pinyin":"zhùmíng","definitions":["известный","знаменитый"],"example":{"zh":"他是一位著名的作家。","py":"tā shì yí wèi zhùmíng de zuòjiā。","en":"He is a famous writer.","ru":"Он известный писатель."}},{"simplified":"旅途","traditional":"旅途","pinyin":"lǚtú","definitions":["путешествие","дорога"],"example":{"zh":"旅途中他认识了很多朋友。","py":"lǚtú zhōng tā rènshi le hěn duō péngyou。","en":"He made many friends during the journey.","ru":"В пути он завёл много друзей."}},{"simplified":"宾馆","traditional":"賓館","pinyin":"bīnguǎn","definitions":["гостиница","отель"],"example":{"zh":"我们住在这家宾馆。","py":"wǒmen zhù zài zhè jiā bīnguǎn。","en":"We are staying at this hotel.","ru":"Мы живём в этой гостинице."},"translations":{"tk":["myhmanhana"]}},{"simplified":"地图","traditional":"地圖","pinyin":"dìtú","definitions":["карта","план местности"],"example":{"zh":"请给我一张地图。","py":"qǐng gěi wǒ yì zhāng dìtú。","en":"Please give me a map.","ru":"Дайте мне, пожалуйста, карту."},"translations":{"tk":["karta"]}},{"simplified":"对面","traditional":"對面","pinyin":"duìmiàn","definitions":["напротив","противоположная сторона"],"example":{"zh":"银行就在对面。","py":"yínháng jiù zài duìmiàn。","en":"The bank is right across the street.","ru":"Банк как раз напротив."}},{"simplified":"好像","traditional":"好像","pinyin":"hǎoxiàng","definitions":["кажется","похоже"],"example":{"zh":"他好像有点不高兴。","py":"tā hǎoxiàng yǒudiǎn bù gāoxìng。","en":"He seems a bit unhappy.","ru":"Он, кажется, немного расстроен."}},{"simplified":"心事","traditional":"心事","pinyin":"xīnshì","definitions":["забота","мысль","переживание"],"example":{"zh":"她好像有心事。","py":"tā hǎoxiàng yǒu xīnshì。","en":"She seems to have something on her mind.","ru":"Похоже, её что-то тревожит."}},{"simplified":"交谈","traditional":"交談","pinyin":"jiāotán","definitions":["беседовать","разговаривать"],"example":{"zh":"他们愉快地交谈起来。","py":"tāmen yúkuài de jiāotán qǐlái。","en":"They started chatting pleasantly.","ru":"Они завели приятную беседу."}},{"simplified":"所","traditional":"所","pinyin":"suǒ","definitions":["место","то, что","используется как грамматический элемент"],"example":{"zh":"这所学校很有名。","py":"zhè suǒ xuéxiào hěn yǒumíng。","en":"This school is very famous.","ru":"Эта школа очень известная."}},{"simplified":"简直","traditional":"簡直","pinyin":"jiǎnzhí","definitions":["просто","совершенно","буквально"],"example":{"zh":"这个消息简直太好了。","py":"Zhège xiāoxi jiǎnzhí tài hǎo le.","en":"This news is simply wonderful.","ru":"Эта новость просто замечательная."}},{"simplified":"分别","traditional":"分別","pinyin":"fēnbié","definitions":["расставание","разделение","отдельно"],"example":{"zh":"我们在车站分别了。","py":"wǒmen zài chēzhàn fēnbié le。","en":"We parted at the station.","ru":"Мы расстались на вокзале."}},{"simplified":"彩虹","traditional":"彩虹","pinyin":"cǎihóng","definitions":["радуга"],"example":{"zh":"雨后天上出现了彩虹。","py":"yǔ hòu tiānshàng chūxiàn le cǎihóng。","en":"After the rain a rainbow appeared in the sky.","ru":"После дождя в небе появилась радуга."}},{"simplified":"意义","traditional":"意義","pinyin":"yìyì","definitions":["значение","смысл"],"example":{"zh":"这份工作很有意义。","py":"zhè fèn gōngzuò hěn yǒu yìyì。","en":"This job is very meaningful.","ru":"Эта работа очень значимая."}},{"simplified":"风雨","traditional":"風雨","pinyin":"fēngyǔ","definitions":["ветер и дождь","невзгоды","испытания"],"example":{"zh":"他们一起经历了许多风雨。","py":"tāmen yīqǐ jīnglì le xǔduō fēngyǔ。","en":"They weathered many storms together.","ru":"Они вместе пережили немало бурь."}},{"simplified":"成功","traditional":"成功","pinyin":"chénggōng","definitions":["успех","успешный"],"example":{"zh":"我相信你一定会成功。","py":"wǒ xiāngxìn nǐ yídìng huì chénggōng。","en":"I believe you will definitely succeed.","ru":"Я верю, что у тебя обязательно получится."}}]