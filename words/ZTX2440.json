[{"simplified":"郊外","traditional":"郊外","pinyin":"jiāowài","definitions":["пригород","за городом"],"example":{"zh":"周末我们去郊外野餐。","py":"zhōumò wǒmen qù jiāowài yěcān。","en":"On weekends we go to the outskirts for a picnic.","ru":"В выходные мы едем за город на пикник."}},{"simplified":"美丽","traditional":"美麗","pinyin":"měilì","definitions":["красивый","прекрасный"],"example":{"zh":"这里的风景很美丽。","py":"zhèli de fēngjǐng hěn měilì。","en":"The scenery here is beautiful.","ru":"Пейзаж здесь очень красивый."}},{"simplified":"美","traditional":"美","pinyin":"měi","definitions":["красивый","прекрасный","хороший"],"example":{"zh":"这里的风景真美。","py":"zhèli de fēngjǐng zhēn měi。","en":"The scenery here is really beautiful.","ru":"Здесь по-настоящему красивые пейзажи."}},{"simplified":"景色","traditional":"景色","pinyin":"jǐngsè","definitions":["пейзаж","вид","ландшафт"],"example":{"zh":"这里的景色真美。","py":"Zhèli de jǐngsè zhēn měi.","en":"The scenery here is really beautiful.","ru":"Здесь по-настоящему красивый вид."}},{"simplified":"如今","traditional":"如今","pinyin":"rújīn","definitions":["ныне","в настоящее время"],"example":{"zh":"如今的生活好多了。","py":"rújīn de shēnghuó hǎo duō le。","en":"Life is much better nowadays.","ru":"Сейчас жизнь стала намного лучше."}},{"simplified":"多么","traditional":"多麼","pinyin":"duōme","definitions":["как","насколько","какой"],"example":{"zh":"今天的天气多么好！","py":"jīntiān de tiānqì duōme hǎo！","en":"How nice the weather is today!","ru":"Какая сегодня хорошая погода!"},"translations":{"tk":["nähili (haýran galma)"]}},{"simplified":"勤劳","traditional":"勤勞","pinyin":"qínláo","definitions":["трудолюбивый","усердный"],"example":{"zh":"她是个勤劳的人。","py":"tā shì ge qínláo de rén。","en":"She is a hardworking person.","ru":"Она трудолюбивый человек."}},{"simplified":"善良","traditional":"善良","pinyin":"shànliáng","definitions":["добрый","сердечный"],"example":{"zh":"她是个善良的女孩。","py":"tā shì ge shànliáng de nǚhái。","en":"She is a kind-hearted girl.","ru":"Она добрая девушка."}},{"simplified":"热爱","traditional":"熱愛","pinyin":"rè’ài","definitions":["страстно любить","горячо любить"],"example":{"zh":"他非常热爱自己的工作。","py":"tā fēicháng rè'ài zìjǐ de gōngzuò。","en":"He loves his work very much.","ru":"Он горячо любит свою работу."}},{"simplified":"友好","traditional":"友好","pinyin":"yǒuhǎo","definitions":["дружелюбный","дружественный"],"example":{"zh":"邻居对我们很友好。","py":"línjū duì wǒmen hěn yǒuhǎo。","en":"The neighbors are very friendly to us.","ru":"Соседи очень дружелюбны к нам."}},{"simplified":"亲爱","traditional":"親愛","pinyin":"qīn’ài","definitions":["дорогой","любимый"],"example":{"zh":"亲爱的妈妈,生日快乐!","py":"qīn'ài de māma, shēngrì kuàilè!","en":"Dear Mom, happy birthday!","ru":"Дорогая мама, с днём рождения!"}},{"simplified":"愿","traditional":"願","pinyin":"yuàn","definitions":["желать","быть готовым","желание"],"example":{"zh":"愿你天天开心。","py":"yuàn nǐ tiāntiān kāixīn。","en":"May you be happy every day.","ru":"Пусть каждый твой день будет радостным."}},{"simplified":"平安","traditional":"平安","pinyin":"píng’ān","definitions":["мир","спокойствие","безопасность"],"example":{"zh":"祝你一路平安。","py":"zhù nǐ yīlù píngān。","en":"Wishing you a safe journey.","ru":"Счастливого и безопасного пути."}},{"simplified":"每","traditional":"每","pinyin":"měi","definitions":["каждый","всякий"],"example":{"zh":"每个人都有名字。","py":"měi ge rén dōu yǒu míngzi。","en":"Everyone has a name.","ru":"У каждого человека есть имя."},"translations":{"tk":["her","her bir"]}},{"simplified":"大街","traditional":"大街","pinyin":"dàjiē","definitions":["главная улица","большая улица"],"example":{"zh":"过年时大街上很热闹。","py":"guònián shí dàjiē shang hěn rènao。","en":"During New Year the main street is very lively.","ru":"В Новый год на главной улице очень оживлённо."}},{"simplified":"鲜花","traditional":"鮮花","pinyin":"xiānhuā","definitions":["свежие цветы"],"example":{"zh":"他送了妈妈一束鲜花。","py":"tā sòng le māma yī shù xiānhuā。","en":"He gave his mom a bouquet of fresh flowers.","ru":"Он подарил маме букет свежих цветов."}},{"simplified":"瓜果","traditional":"瓜果","pinyin":"guāguǒ","definitions":["дыни и фрукты"],"example":{"zh":"秋天瓜果飘香。","py":"qiūtiān guāguǒ piāoxiāng。","en":"In autumn the air is fragrant with melons and fruit.","ru":"Осенью воздух наполнен ароматом фруктов."}}]